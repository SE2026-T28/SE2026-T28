{
  "name": "app04-identity-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "predev": "node scripts/check-node.cjs",
    "prebuild": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file=.env dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "oidc-provider": "9.12.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/oidc-provider": "9.12.1",
    "prisma": "7.10.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
