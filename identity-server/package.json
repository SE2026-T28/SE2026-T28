{
  "name": "app04-identity-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "predev": "node scripts/check-node.cjs",
    "prebuild": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file=.env dist/src/server.js",
    "db:generate": "node scripts/prisma-command.mjs generate",
    "db:migrate": "node scripts/prisma-command.mjs dev",
    "db:deploy": "node scripts/prisma-command.mjs deploy",
    "db:status": "node scripts/prisma-command.mjs status",
    "test:isolated": "node scripts/run-isolated-tests.mjs",
    "pretest": "node scripts/check-test-database.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:safety": "npm run build && node --test dist/test/database-safety.test.js",
    "test:s3": "npm run build && node --test dist/test/m2-authorization-boundary.test.js",
    "pretest:headers": "node scripts/check-test-database.mjs",
    "test:headers": "node --test ../tests/security/check-headers.test.mjs && node ../tests/security/server-headers.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "oidc-provider": "9.12.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/oidc-provider": "9.12.1",
    "prisma": "7.10.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
