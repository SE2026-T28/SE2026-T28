NODE_ENV=development
PORT=3000

# O1 - OIDC Provider / Discovery
OIDC_ISSUER=http://localhost:3000
OIDC_CLIENT_ID=app04-react-demo
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
OIDC_SCOPES=openid profile email api:read offline_access
OIDC_CORS_ORIGIN=http://localhost:5173
# Generate a local key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required: keep it stable across restarts; never commit the generated value.
# OIDC_COOKIE_KEYS=<generated-64-hex-character-key>
# Required: use a different stable key to encrypt PostgreSQL OIDC payloads across restarts.
# OIDC_ADAPTER_KEY=<another-generated-64-hex-character-key>

# A1 - PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app04?schema=public"
